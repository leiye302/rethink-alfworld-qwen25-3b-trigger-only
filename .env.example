# Copy to .env. Never commit real credentials. Paths resolve from the repository.
SFT_PYTHON=./.venv-sft/bin/python
OPSD_PYTHON=./.venv-opsd/bin/python
TRAIN_GPUS=0
EVAL_GPU=0
RAY_ADDRESS=local
ALFWORLD_DATA=./data/alfworld
RETHINK_API_ENDPOINT=${RETHINK_API_ENDPOINT:-}
RETHINK_API_KEY=${RETHINK_API_KEY:-}
RETHINK_API_CONCURRENCY=4
HF_TOKEN=${HF_TOKEN:-}
# Optional short writable Ray temporary parent, e.g. /tmp.
# RETHINK_RUNTIME_ROOT=/tmp
